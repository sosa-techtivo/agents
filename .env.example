# Techtivo AGENTS — local environment variables
# Copy this file to .env.local and set real values there. Never commit real credentials.

AGENTS_ADMIN_EMAIL=admin@example.com
AGENTS_ADMIN_PASSWORD=change-this-password
AGENTS_SESSION_SECRET=replace-with-a-long-random-string

# MARKO QA agent — read-only Playwright credentials. Server-only, never NEXT_PUBLIC_*.
MARKO_BASE_URL=https://example-marko-instance.vercel.app
MARKO_QA_EMAIL=qa@example.com
MARKO_QA_PASSWORD=change-this-password

# JIRITA QA agent — Playwright credentials for three QA roles. Writes are
# restricted at runtime to JIRITA_QA_PROJECT_SLUG only. Server-only, never NEXT_PUBLIC_*.
JIRITA_BASE_URL=https://example-jirita-instance.example.com
JIRITA_ADMIN_EMAIL=qa-admin@example.com
JIRITA_ADMIN_PASSWORD=change-this-password
JIRITA_PL_EMAIL=qa-lead@example.com
JIRITA_PL_PASSWORD=change-this-password
JIRITA_MEMBER_EMAIL=qa-member@example.com
JIRITA_MEMBER_PASSWORD=change-this-password
JIRITA_QA_PROJECT_SLUG=jirita-live
