# Techtivo AGENTS — local environment variables
# Copy this file to .env.local and set real values there. Never commit real credentials.

AGENTS_ADMIN_EMAIL=admin@example.com
AGENTS_ADMIN_PASSWORD=change-this-password
AGENTS_SESSION_SECRET=replace-with-a-long-random-string

# MARKO QA agent — read-only Playwright credentials. Server-only, never NEXT_PUBLIC_*.
MARKO_BASE_URL=https://example-marko-instance.vercel.app
MARKO_QA_EMAIL=qa@example.com
MARKO_QA_PASSWORD=change-this-password
